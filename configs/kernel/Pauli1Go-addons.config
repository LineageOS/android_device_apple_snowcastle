# From Nick Chan's message in Element chat room
CONFIG_IOMMU_SUPPORT=y
CONFIG_APPLE_DART=y

# Figured out by myself
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_APPLE_H9P=y
CONFIG_BLK_DEV_NVME=y

# Requirement for CONFIG_APPLE_SIO_DMA=m
CONFIG_APPLE_SIO=m

# From https://github.com/Pauli1Go/HoolockLinux-bringup-docs/blob/main/docs/touch.md#kernel-configuration
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_APPLE_Z2=m
CONFIG_SPI_APPLE=y
CONFIG_DMADEVICES=y
CONFIG_APPLE_SIO_DMA=m
CONFIG_COMMON_CLK_APPLE_T8010_TOUCH=y
